      "kind": "nav",
      "refersTo": "icon-button",
      "description": "Sticky programme masthead: wordmark, six house squares, links, circular theme toggle.",
      "html": "<header class=\"ds-mast\"><a class=\"ds-word\" href=\"#\">CPE102 <span>// SEC C</span></a><span class=\"ds-strip\"><i style=\"background:#D7352A\"></i><i style=\"background:#2563EB\"></i><i style=\"background:#1B7F36\"></i><i style=\"background:#F5C518\"></i><i style=\"background:#F57C1F\"></i><i style=\"background:#6B6F78\"></i></span><nav class=\"ds-nav\"><a href=\"#\">Overview</a><a href=\"#\">16-Week Archive</a><a href=\"#\">Team</a></nav><button class=\"ds-toggle\" aria-label=\"Switch colour theme\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"/></svg></button></header>",
      "css": ".ds-mast{display:flex;align-items:center;gap:24px;height:64px;padding:0 24px;background:#FFFFFF;border-bottom:1px solid #DCDCD7;color:#15161A}.ds-word{font-family:Archivo,'Arial Narrow',sans-serif;font-stretch:125%;font-weight:900;font-size:1.25rem;text-decoration:none;color:inherit}.ds-word span{font-weight:600;color:#4A4D55}.ds-strip{display:flex;gap:3px}.ds-strip i{display:block;width:12px;height:12px;border-radius:2px}.ds-nav{display:flex;gap:22px;margin-left:auto;font-family:Archivo,sans-serif;font-weight:600;font-size:.9rem}.ds-nav a{padding:6px 0;border-bottom:2px solid transparent;color:inherit;text-decoration:none}.ds-nav a:hover{border-bottom-color:currentColor}.ds-toggle{display:grid;place-items:center;width:40px;height:40px;border:1px solid #DCDCD7;border-radius:50%;background:#F1F1EE;color:inherit;cursor:pointer}.ds-toggle:hover{border-color:#15161A}.ds-toggle:focus-visible,.ds-nav a:focus-visible{outline:3px solid #2563EB;outline-offset:3px}"
    },

      "css": ".ds-week{--house:#2563EB;--on-house:#FFFFFF;display:grid;grid-template-columns:112px 1fr;column-gap:28px;width:560px;padding:18px 16px;border:0;border-bottom:2px solid #DCDCD7;border-radius:4px;background:transparent;color:#15161A;text-align:left;cursor:pointer;transition:background-color .35s cubic-bezier(.16,1,.3,1),color .35s cubic-bezier(.16,1,.3,1)}.ds-week-no{display:flex;flex-direction:column;justify-content:space-between;aspect-ratio:1;padding:12px 14px;border-radius:4px;background:var(--house);color:var(--on-house);font-family:Archivo,'Arial Narrow',sans-serif;font-stretch:125%;font-weight:900;font-size:2.6rem;line-height:.9}.ds-week-no small{font-stretch:100%;font-weight:700;font-size:.7rem;letter-spacing:.1em}.ds-week-main{display:flex;flex-direction:column;gap:4px}.ds-week-date{color:#4A4D55;font-family:Archivo,sans-serif;font-weight:600;font-size:.8rem;letter-spacing:.06em}.ds-week-title{font-family:Archivo,sans-serif;font-stretch:105%;font-weight:800;font-size:1.6rem;line-height:1.1}.ds-week-preview{color:#4A4D55;font-family:'Source Sans 3',sans-serif}.ds-week:hover,.ds-week:focus-visible{background:var(--house);color:var(--on-house)}.ds-week:hover .ds-week-no,.ds-week:focus-visible .ds-week-no{background:var(--on-house);color:var(--house)}.ds-week:hover :is(.ds-week-date,.ds-week-preview),.ds-week:focus-visible :is(.ds-week-date,.ds-week-preview){color:inherit}.ds-week:focus-visible{outline:3px solid #2563EB;outline-offset:3px}"
    },

      "kind": "button",
      "refersTo": "doc-link",
      "description": "Panel-filled resource link with stroke icons; border turns ink on hover.",
      "html": "<a class=\"ds-doc\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"/><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"/></svg><span>Era-One Progress Report</span><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></a>",
      "css": ".ds-doc{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid #DCDCD7;border-radius:4px;background:#F1F1EE;color:#15161A;font-family:Archivo,'Arial Narrow',sans-serif;font-weight:700;text-decoration:none}.ds-doc:hover{border-color:#15161A}.ds-doc:focus-visible{outline:3px solid #2563EB;outline-offset:3px}"
